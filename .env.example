# Copy to .env and adjust. scripts/serve.py reads these.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
# cpu | cuda | xpu | mps
LAYA_DEVICE=cpu
# english | multilingual | typed-decisions (comma list). Preload only what you serve.
LAYA_MODELS=multilingual
LAYA_DEFAULT_MODEL=multilingual
LAYA_MAX_LOADED=1
# Set this if the port is ever exposed beyond 127.0.0.1.
LAYA_API_KEY=
# Move the Hugging Face cache into the repo (ignored by git).
HF_HUB_CACHE=./hf-cache
